# Copy to .env for local development. Never commit a real .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-locally-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres in every real environment. Local dev may use sqlite:///db.sqlite3.
DATABASE_URL=postgres://tours:tours@localhost:5432/tours

# Staff admin lives on an unguessable path in production.
DJANGO_ADMIN_URL=staff/

# Email (Postmark in production; console backend in development).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=bookings@example.com

# Set once the site is behind TLS.
DJANGO_SECURE_SSL_REDIRECT=false

# Stripe. Test keys locally; live keys only in production.
# Booking stays switched off until BOTH of these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Absolute base URL used in emails and Stripe redirects.
SITE_BASE_URL=http://127.0.0.1:8000
BOOKING_LINK_MAX_AGE_DAYS=30
